// The site's bridge to the library compiled to JavaScript.
supported_targets = "js"

import {
  "moonbitstack/moonjrpc",
  "moonbitstack/moonjrpc/peer",
  "moonbitlang/async",
  "moonbitlang/async/io",
  "moonbitlang/async/js_async",
}

options(
  link: {
    "js": { "exports": [ "answer", "framed", "conversation" ], "format": "esm" },
  },
)
