name = "moonbitstack/moonjrpc"

version = "0.1.2"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonjrpc"

license = "Apache-2.0"

keywords = [
  "json-rpc",
  "jrpc",
  "jsonrpc",
  "rpc",
  "json",
  "peer",
  "bidirectional",
  "ndjson",
  "stdio",
  "content-length",
  "lsp",
  "mcp",
  "acp",
  "moonbit",
]

description = "JSON-RPC 2.0 for MoonBit: messages, a method table, two-way calls and framing."

source = "src"

import {
  "moonbitlang/async@0.22.5",
}
